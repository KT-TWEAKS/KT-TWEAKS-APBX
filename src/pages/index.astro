        <div class="highlights-grid" style="margin-bottom:32px" data-reveal>
            <div class="hl-card hl-card-fsos">
                <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#8b5cf6,#a78bfa,transparent)"></div>
                <div>
                    <div style="display:inline-flex;align-items:center;gap:8px;padding:4px 14px;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.25);border-radius:999px;font-family:var(--fm);font-size:10px;color:#8b5cf6;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px"><i class="fas fa-star" style="font-size:8px"></i> DESTAQUE</div>
