                const d = document.createElement('div');
                d.className = 'pbc';
                d.style.animationDelay = `${i * 0.06}s`;
                d.innerHTML = `<div class="pbc-top"><div class="pbc-icon icon-${p.cat}"><i class="fas fa-${ICONS[p.cat] || 'bolt'}"></i></div><div class="pbc-meta"><div class="pbc-ver">v${p.version}</div></div></div><div class="pbc-body"><div class="pbc-name"><span>${p.name}</span><span title="Verificado no licensing KT WIRZADE" style="color:#35d56d;font-size:12px;margin-left:6px"><i class="fas fa-circle-check"></i></span></div><div class="pbc-desc">${p.desc}</div><div style="display:flex;gap:10px;flex-wrap:wrap;font-family:var(--fm);font-size:10.5px;color:var(--t3);margin-top:8px"><span><i class="fas fa-list-check"></i> ${p.totalActions} acoes</span><span><i class="fas fa-weight-hanging"></i> ${p.sizeMB} MB</span><span><i class="fas fa-wifi"></i> ${p.networkRequired} rede</span><span style="color:${sev[1]}"><i class="fas fa-shield-halved"></i> risco ${sev[0]}</span></div><div class="pbc-tags">${p.tags.map(t => `<span class="tag tag-${t}">${TAGS[t] || t}</span>`).join('')}<span class="tag tag-win10">Win 10</span><span class="tag tag-win11">Win 11</span></div></div><div class="pbc-footer"><div class="pbc-cmd">ORIGINAL · compatível ${p.name}</div><a href="${dl}" target="_blank" class="pbc-dl" onclick="return confirm('${p.name} — playbook original da comunidade AME. Continuar?')"><i class="fas fa-download"></i> Baixar</a><a href="comparar.html?pb=${encodeURIComponent(p.productCode)}" class="pbc-code" style="color:#c4b5fd"><i class="fas fa-scale-balanced"></i> Comparar</a><a href="#" class="pbc-code" data-details="${encodeURIComponent(p.productCode)}" style="color:#c4b5fd"><i class="fas fa-microscope"></i> Detalhes</a></div>`;
                g.appendChild(d);
                d.addEventListener('mousemove', e => {
                    const r = d.getBoundingClientRect();
                    const x = (e.clientX - r.left) / r.width - .5;
                    const y = (e.clientY - r.top) / r.height - .5;
                    d.style.transform = `translateY(-8px) perspective(800px) rotateY(${x * 6}deg) rotateX(${-y * 5}deg)`;
                    d.style.transition = 'transform 0.1s ease';
                });
