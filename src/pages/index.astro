---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const catalogPath = path.join(process.cwd(), 'public', 'catalog.json');
const catalog = JSON.parse(fs.readFileSync(catalogPath, 'utf8'));
const isPublishedPlaybook = (item: any) => Boolean(item?.verified && /^https:\/\//i.test(String(item?.downloadUrl || '')) && /^[0-9a-f]{64}$/i.test(String(item?.sha256 || '')));
const playbooks = Array.isArray(catalog.playbooks) ? catalog.playbooks.filter(isPublishedPlaybook) : [];
const categoryOrder = ['gaming', 'performance', 'balanced', 'privacy', 'lightweight'];
const categories = [...new Set(playbooks.map((item: any) => item.category).filter(Boolean))].sort((a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b));
const categoryLabel: Record<string, string> = { gaming: 'Gaming', performance: 'Performance', privacy: 'Privacidade', lightweight: 'Leve', balanced: 'Balanceado' };
const categoryDescription: Record<string, string> = { gaming: 'jogos e latência', performance: 'resposta e leveza', balanced: 'estabilidade e controle' };
const severityLabel: Record<string, string> = { ok: 'Baixo risco', low: 'Baixo risco', medium: 'Risco médio', high: 'Alto risco', critical: 'Crítico', unknown: 'Auditado' };
const formatBytes = (value: unknown) => {
  const bytes = Number(value || 0);
  if (!bytes) return 'Tamanho não informado';
  if (bytes >= 1024 ** 3) return `${(bytes / 1024 ** 3).toFixed(1)} GB`;
  return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
};
const cleanCatalogDescription = (value: unknown) => {
  const raw = String(value || '').replace(/\r/g, '');
  const docUrl = raw.match(/https?:\/\/[^\s|│╮╰]+/i)?.[0]?.replace(/[),.;:]+$/, '') || null;
  const lines = raw
    .split(/\n+/)
    .map((line) => line.trim())
    .filter((line) => line && !/[╭╮╰╯⚠]/.test(line) && !/https?:\/\//i.test(line))
    .filter((line) => !/documentation|documentação|read .* first|leia .* antes/i.test(line))
    .map((line) => line.replace(/[│─━═]+/g, ' ').replace(/\s+/g, ' ').trim());
  return {
    summary: lines.join(' ') || 'Playbook publicado no catálogo oficial.',
    notice: /critical|crítico|documentation|documentação|read .* first|leia .* antes/i.test(raw)
      ? 'Leia a documentação antes de aplicar'
      : null,
    docUrl,
  };
};
---
<BaseLayout title="KT APBX — catálogo verificado" description="Catálogo oficial de playbooks APBX verificados pelo KT WIRZADE.">
  <section class="hero shell">
    <div class="eyebrow"><span class="pulse"></span> KT WIRZADE · APBX RELEASES VERIFICADAS</div>
    <div class="hero-grid">
      <div>
        <h1>Playbooks para um Windows <em>mais seu.</em></h1>
        <p class="hero-lead">Descubra, compare e baixe APBX auditados. Cada arquivo publicado aqui nasce no painel de registro e chega com origem, versão e hash verificáveis.</p>
        <div class="hero-actions"><a class="button button-primary" href="#catalogo">Explorar catálogo <span>↓</span></a><a class="button button-ghost" href="/changelog-playbooks">Ver atualizações <span>↗</span></a></div>
        <div class="trust-row"><span>✓ SHA-256 público</span><span>✓ Download direto</span><span>✓ Status verificado</span></div>
        <div class="ecosystem-route" aria-label="Fluxo entre KT APBX e KT WIRZADE"><span><i>↗</i> APBX → WIRZADE</span><small>descubra aqui, revise e aplique no aplicativo</small><a href="https://kt-wirzade-site.vercel.app/docs/fluxo-apbx" target="_blank" rel="noreferrer">Ver como funciona <span>↗</span></a></div>
      </div>
    </div>
  </section>
  <section class="metrics shell" aria-label="Resumo do catálogo"><div><strong>{playbooks.length.toString().padStart(2, '0')}</strong><span>publicados</span></div><div><strong>{categories.length.toString().padStart(2, '0')}</strong><span>categorias</span></div><div><strong>100%</strong><span>verificados</span></div><div><strong>0</strong><span>arquivos no deploy</span></div></section>
  <section class="catalog-section shell" id="catalogo">
    <div class="section-heading"><div><div class="eyebrow">CATÁLOGO OFICIAL</div><h2>Escolha seu ponto de partida</h2></div><p>Somente itens verificados e com download publicado aparecem aqui.</p></div>
    <div class="catalog-toolbar"><label class="search-field"><span aria-hidden="true">⌕</span><input id="catalog-search" type="search" placeholder="Buscar por nome, autor ou código…" autocomplete="off" /></label><div class="filter-group" role="group" aria-label="Filtrar por categoria"><button class="filter-button active" data-filter="all">Todos</button>{categories.map((category) => <button class="filter-button" data-filter={category}>{categoryLabel[category] || category}</button>)}</div></div>
    <div class="category-guide" aria-label="Como as categorias foram definidas"><span class="category-guide-label">LEITURA RÁPIDA</span><span class="category-guide-item category-guide-gaming"><i></i><b>Gaming</b><small>{categoryDescription.gaming}</small></span><span class="category-guide-item category-guide-performance"><i></i><b>Performance</b><small>{categoryDescription.performance}</small></span><span class="category-guide-item category-guide-balanced"><i></i><b>Balanceado</b><small>{categoryDescription.balanced}</small></span></div>
    {playbooks.length > 0 ? <div class="catalog-grid" id="catalog-grid">{playbooks.map((item: any, index: number) => { const severity = item.analysis?.severity || 'unknown'; const tags = Array.isArray(item.tags) ? item.tags.slice(0, 4) : []; const actionCount = Number(item.analysis?.totalActions || 0); const description = cleanCatalogDescription(item.description); const documentationUrl = [description.docUrl, item.website].find((value) => /^https:\/\//i.test(String(value || ''))) || null; return <article class="catalog-card" data-card data-category={item.category || 'balanced'} data-search={`${item.name} ${item.author} ${item.productCode} ${tags.join(' ')}`.toLowerCase()}><div class="card-top"><span class="card-index">{String(index + 1).padStart(2, '0')}</span><span class="verified"><i>✓</i> Verificado no WIRZADE</span></div><div class="card-title-row"><h3>{item.name}</h3><span class="version">v{item.version}</span></div><p class="card-description">{description.summary}</p>{description.notice ? <div class="card-notice"><span>{description.notice}</span>{documentationUrl ? <a href={documentationUrl} target="_blank" rel="noreferrer">Abrir documentação ↗</a> : null}</div> : null}<div class="tag-row"><span class="category-tag" data-category={item.category || 'balanced'}>{categoryLabel[item.category] || item.category || 'Balanceado'}</span>{tags.map((tag: string) => <span class="tag">{tag}</span>)}</div><div class="card-meta"><span><small>AUTHOR</small>{item.author || 'Desconhecido'}</span><span><small>ESCOPO</small>{actionCount ? `${actionCount.toLocaleString('pt-BR')} ações` : 'Não informado'}</span><span><small>AUDIT</small><b class={`severity severity-${severity}`}>{severityLabel[severity] || 'Auditado'}</b></span></div><div class="card-foot"><span class="file-size">{formatBytes(item.analysis?.sizeBytes)}</span><a class="download-link" href={item.downloadUrl} target="_blank" rel="noreferrer">Download <span>↗</span></a></div><details class="hash-details"><summary>Verificar integridade</summary><code>{item.sha256}</code></details></article>; })}</div> : <div class="empty-state"><span class="empty-icon">◌</span><h3>O próximo release começa aqui.</h3><p>Nenhum APBX verificado foi publicado ainda. O catálogo será atualizado quando uma nova versão for aprovada internamente.</p><span class="empty-note">Publicação controlada · downloads somente de releases verificados</span></div>}
    <div class="no-results" id="no-results" hidden><strong>Nada encontrado.</strong><span>Tente outro nome ou remova o filtro de categoria.</span></div>
  </section>
  <section class="manifest-section shell"><div class="manifest-card"><div><div class="eyebrow">COMO FUNCIONA</div><h2>Uma fonte, um hash, um download.</h2><p>O repositório público guarda apenas o catálogo. O arquivo APBX fica como asset de GitHub Release, evitando o limite de arquivos do repositório e mantendo cada versão rastreável.</p><div class="manifest-actions"><a class="button button-primary" href="https://kt-wirzade-site.vercel.app/docs/fluxo-apbx" target="_blank" rel="noreferrer">Ler o fluxo no WIRZADE ↗</a><a class="button button-ghost" href="/comparar">Comparar playbooks</a></div></div><div class="manifest-side"><div class="manifest-list"><div><b>01</b><span>Registro operacional separado</span></div><div><b>02</b><span>Auditoria e SHA-256</span></div><div><b>03</b><span>Release e catálogo atualizados</span></div></div><p class="manifest-note">Nenhum link de administração é publicado nesta interface.</p></div></div></section>
  <script is:inline>
    const search = document.querySelector('#catalog-search'); const buttons = [...document.querySelectorAll('[data-filter]')]; const cards = [...document.querySelectorAll('[data-card]')]; const empty = document.querySelector('#no-results'); let filter = 'all';
    function render(){const query=(search?.value||'').trim().toLowerCase();let visible=0;cards.forEach((card)=>{const match=(!query||card.dataset.search.includes(query))&&(filter==='all'||card.dataset.category===filter);card.hidden=!match;if(match)visible++;});if(empty)empty.hidden=visible>0||cards.length===0;}
    search?.addEventListener('input',render); buttons.forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.filter;buttons.forEach((item)=>item.classList.toggle('active',item===button));render();}));
  </script>
</BaseLayout>
