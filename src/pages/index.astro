            <div style="display:flex;gap:16px;flex-wrap:wrap"><a href="https://kt-wirzade-site.vercel.app" target="_blank" class="btn-main" style="text-decoration:none"><i class="fas fa-circle-info"></i> Ver Detalhes</a><a href="#downloads" class="btn-ghost"><i class="fas fa-arrow-down"></i> Ver Playbooks</a></div></div>
