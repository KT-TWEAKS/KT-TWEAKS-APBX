        });

        const navProg = document.getElementById('nav-progress');
        window.addEventListener('scroll', () => {
            const h = document.documentElement.scrollHeight - window.innerHeight;
            navProg.style.width = (scrollY / h * 100) + '%';
        }, { passive: true });

        const parallaxLayers = document.querySelectorAll('[data-speed]');
        window.addEventListener('scroll', () => {
            const sy = window.scrollY;
            parallaxLayers.forEach(layer => {
                const speed = parseFloat(layer.dataset.speed);
                layer.style.transform = `translateY(${sy * speed}px)`;
            });
        }, { passive: true });

        document.querySelectorAll('.btn-main, .btn-ghost, .pbc-dl').forEach(btn => {
            btn.addEventListener('click', function(e) {
                const ripple = document.createElement('span');
                const r = this.getBoundingClientRect();
                const size = Math.max(r.width, r.height);
                ripple.style.cssText = `position:absolute;width:${size}px;height:${size}px;left:${e.clientX - r.left - size/2}px;top:${e.clientY - r.top - size/2}px;background:rgba(255,255,255,.3);border-radius:50%;animation:ripple .6s linear;pointer-events:none`;
                this.appendChild(ripple);
                setTimeout(() => ripple.remove(), 600);
            });
        });

        document.querySelectorAll('.btn-main, .nav-cta, .pbc-dl').forEach(btn => {
            btn.addEventListener('mousemove', e => {
                const r = btn.getBoundingClientRect();
                const x = e.clientX - r.left - r.width / 2;
                const y = e.clientY - r.top - r.height / 2;
                btn.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px) scale(1.02)`;
            });
            btn.addEventListener('mouseleave', () => { btn.style.transform = ''; });
        });
            function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}

        
        function kmCell(n, l, cls) { return '<div class="km-cell"><div class="km-n ' + (cls||'') + '">' + n + '</div><div class="km-l">' + l + '</div></div>'; }
        function kmChips(arr) { return (arr && arr.length) ? arr.map(x => '<span class="km-chip">' + esc(String(x)) + '</span>').join('') : '<span style="color:var(--t3);font-size:12px">— nenhum —</span>'; }
        window.showDetails = function(codeEnc) {
            const code = decodeURIComponent(codeEnc);
            const p = CATALOG.find(x => x.productCode === code);
            if (!p) return;
            const d = p.deep || {};
            const sevColor = p.severity === 'high' ? '#a78bfa' : p.severity === 'medium' ? '#f59e0b' : '#35d56d';
            let html = '<h3>' + esc(p.name) + '</h3><div class="km-sub">v' + esc(p.version) + ' · ProductCode ' + esc(p.productCode) + ' · SHA-256 ' + esc((p.sha256||'').slice(0,16)) + '…</div>';
            html += '<div class="km-grid">'
                + kmCell(p.totalActions, 'Ações totais')
                + kmCell(p.taskFiles, 'Arquivos de tarefa')
                + kmCell(d.registryCount || 0, 'Mudanças de registro')
                + kmCell(d.servicesCount || 0, 'Serviços afetados')
                + kmCell(d.appxCount || 0, 'Apps UWP removidos')
                + kmCell(d.downloadsCount || 0, 'Downloads', d.downloadsCount ? 'hl-a' : '')
                + kmCell(d.scheduledTaskCount || 0, 'Tarefas agendadas')
                + kmCell('<span style="color:' + sevColor + '">' + p.severity.toUpperCase() + '</span>', 'Severidade de risco')
                + '</div>';
            if ((p.risksList || []).length) {
                html += '<div class="km-sec"><h4><i class="fas fa-triangle-exclamation"></i> Riscos detectados (' + p.risks.length + ')</h4>'
                    + p.risksList.map(r => '<div class="km-risk">' + esc(r).replace(/</g,'&lt;') + '</div>').join('') + '</div>';
            }
            if ((d.servicesSample || []).length)
                html += '<div class="km-sec"><h4>Serviços afetados (' + d.servicesCount + ')</h4><div class="km-chips">' + kmChips(d.servicesSample) + '</div></div>';
            if ((d.appxSample || []).length)
                html += '<div class="km-sec"><h4>Apps UWP removidos</h4><div class="km-chips">' + kmChips(d.appxSample) + '</div></div>';
            if ((d.downloads || []).length)
                html += '<div class="km-sec"><h4>Downloads durante a aplicação</h4>' + d.downloads.slice(0,10).map(dl => '<div class="km-risk" style="background:rgba(6,182,212,.07);border-color:rgba(6,182,212,.2);color:#67e8f9">' + esc(dl.url || dl.dest || '?') + '</div>').join('') + '</div>';
            if ((d.optionsPages || []).length) {
                html += '<div class="km-sec"><h4>Opções customizáveis</h4>';
                d.optionsPages.forEach(pg => {
                    html += '<div style="margin-bottom:10px"><b style="font-size:12.5px;color:var(--t1)">' + esc(pg.page) + '</b><div class="km-chips" style="margin-top:5px">' + pg.options.slice(0,12).map(o => '<span class="km-chip" title="' + esc(o.desc||'') + '">' + esc(o.name) + '</span>').join('') + '</div></div>';
                });
                html += '</div>';
            }
            if ((p.supportedBuilds || []).length)
                html += '<div class="km-sec"><h4>Builds suportadas</h4><div class="km-chips">' + kmChips(p.supportedBuilds) + '</div></div>';
            document.getElementById('kt-modal-body').innerHTML = html;
            document.getElementById('kt-modal-bg').classList.add('open');
        };
        document.getElementById('kt-modal-bg').addEventListener('click', e => { if (e.target.id === 'kt-modal-bg') e.target.classList.remove('open'); });
        document.addEventListener('click', e => {
            const t = e.target.closest('[data-details]');
            if (t) { e.preventDefault(); showDetails(t.dataset.details); }
        });

        function showDetails(code){
            const p = CATALOG.find(x => encodeURIComponent(x.productCode) === code || x.productCode === code);
            if(!p) return;
            const m = document.getElementById('kt-modal-body');
            const d = p.deep || {};
            const risk = (p.risksList||p.risks||[]);
            const sev = sevOf(p.severity);
            const reg = d.registryCount||p.riskBreakdown?.registry||0;
            const svc = d.servicesCount||p.riskBreakdown?.services||0;
            const cmd = d.commandsCount||p.riskBreakdown?.commands||0;
            const apps = p.riskBreakdown?.apps||0;
            const dl = d.downloadsCount||0;
            const net = p.networkRequired||0;
            m.innerHTML = `
            <div class="km-head">
                <div class="km-icon icon-${p.cat}"><i class="fas fa-${ICONS[p.cat]||'bolt'}"></i></div>
                <div class="km-htext">
                    <div class="km-title">${p.name}</div>
                    <div class="km-sub">v${p.version} · ${p.sizeMB} MB · ${p.totalActions} ações · ${p.taskFiles} tarefas</div>
                </div>
                <span class="km-badge" style="background:${sev[1]}1a;color:${sev[1]};border-color:${sev[1]}55">risco ${sev[0]}</span>
            </div>
            <div class="km-grid">
                ${stat('Registry', reg, '#a78bfa')}
                ${stat('Serviços', svc, '#60a5fa')}
                ${stat('Comandos', cmd, '#f472b6')}
                ${stat('Apps UWP', apps, '#34d399')}
                ${stat('Downloads', dl, '#fbbf24')}
                ${stat('Rede req.', net+'', '#a78bfa')}
            </div>
            <div class="km-sec">
                <h4><i class="fas fa-microscope"></i> Auditoria técnica</h4>
                <p class="km-desc">${p.desc}</p>
                <div class="km-meta"><span><i class="fas fa-windows"></i> Builds: ${p.supportedBuilds&&p.supportedBuilds.length? p.supportedBuilds.slice(0,8).join(', ') : 'todas'}</span><span><i class="fas fa-tags"></i> ${(p.tags||[]).map(t=>TAGS[t]||t).join(' · ')}</span></div>
            </div>
            <div class="km-sec">
                <h4><i class="fas fa-triangle-exclamation"></i> Riscos detectados (${risk.length})</h4>
                ${risk.length? '<ul class="km-risks">'+risk.slice(0,10).map(r=>`<li>${r.length>150? r.slice(0,150)+'…' : r}</li>`).join('')+(risk.length>10?'<li class="km-more">+ '+(risk.length-10)+' riscos adicionais analisados</li>':'')+'</ul>' : '<p class="km-ok"><i class="fas fa-circle-check"></i> Nenhum risco crítico identificado na auditoria.</p>'}
            </div>
            <div class="km-foot">
                <a href="${p.url}" target="_blank" class="km-dl"><i class="fas fa-download"></i> Baixar original</a>
                <a href="comparar.html?pb=${encodeURIComponent(p.productCode)}" class="km-cmp"><i class="fas fa-scale-balanced"></i> Comparar</a>
            </div>`;
            document.getElementById('kt-modal-bg').classList.add('open');
        }
        function stat(l,v){return `<div class="km-stat"><div class="km-stv">${v??0}</div><div class="km-stl">${l}</div></div>`}
        function sevOf(s){return {high:['alto','#c4b5fd'],medium:['médio','#fcd34d'],ok:['baixo','#86efac']}[s]||['—','#cbd5e1']}
</script>

<div class="kt-modal-bg" id="kt-modal-bg">
  <div class="kt-modal">
    <button class="km-close" onclick="document.getElementById('kt-modal-bg').classList.remove('open')">&times;</button>
    <div id="kt-modal-body"></div>
  </div>
</div>
</BaseLayout>
