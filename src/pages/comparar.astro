const ICONS = { gaming:'gamepad', privacy:'shield-halved', performance:'tachometer-alt', lightweight:'feather', balanced:'scale-balanced' };
const TAGS = { gaming:'Gaming', privacy:'Privacy', performance:'Performance', lightweight:'Leve', balanced:'Balanceado' };

// popula selects
['sel-a','sel-b','sel-c'].forEach(id => {
    const sel = document.getElementById(id);
    CATALOG.slice().sort((x,y)=>x.name.localeCompare(y.name)).forEach(p => {
        const o = document.createElement('option');
        o.value = p.productCode; o.textContent = p.name + ' v' + p.version;
        sel.appendChild(o);
    });
});

// deep-link ?pb=CODE pre-seleciona
const params = new URLSearchParams(location.search);
if (params.get('pb')) document.getElementById('sel-a').value = params.get('pb');
if (params.get('vs') || params.get('pb2')) document.getElementById('sel-b').value = params.get('vs') || params.get('pb2');
if (params.get('pb3') || params.get('vs2')) document.getElementById('sel-c').value = params.get('pb3') || params.get('vs2');

function byCode(code){ return CATALOG.find(p => p.productCode === code); }
function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

function cardHtml(p, rank) {
    const d = p.deep || {};
    const sevColor = p.severity==='high' ? '#a78bfa' : p.severity==='medium' ? '#f59e0b' : '#35d56d';
    const maxActions = Math.max(...CATALOG.map(x=>x.totalActions||0));
    const maxSize = Math.max(...CATALOG.map(x=>x.sizeMB||0));
    const actionsPct = Math.round((p.totalActions/maxActions)*100);
    const sizePct = Math.round((p.sizeMB/maxSize)*100);
    return `<div class="cmp-card" style="animation-delay:.05s">
        ${rank===1?'<div class="cmp-winner">Melhor p/ gaming</div>':''}
        <h3>${esc(p.name)}<button class="cmp-close" onclick="removeCard(this)" title="Remover">&times;</button></h3>
        <div class="cmp-ver">v${esc(p.version)} · ${TAGS[p.cat]||p.cat} · ${p.taskFiles} tarefa(s)</div>
        <div class="cmp-desc">${esc(p.desc)}</div>
        <div class="cmp-metrics">
            <div class="cm"><div class="cm-n">${p.totalActions}</div><div class="cm-l">Acoes</div></div>
            <div class="cm"><div class="cm-n ${p.networkRequired?'hl-a':'hl-g'}">${p.networkRequired}</div><div class="cm-l">Precisam de rede</div></div>
            <div class="cm"><div class="cm-n">${p.risksCount}</div><div class="cm-l">Riscos detectados</div></div>
            <div class="cm"><div class="cm-n">${p.optionsCount||0}</div><div class="cm-l">Opcoes customizaveis</div></div>
            <div class="cm"><div class="cm-n">${p.sizeMB} MB</div><div class="cm-l">Tamanho</div></div>
            <div class="cm"><div class="cm-n" style="color:${sevColor}">${p.severity.toUpperCase()}</div><div class="cm-l">Severidade risco</div></div>
            <div class="cm"><div class="cm-n">${d.registryCount||0}</div><div class="cm-l">Mudanças de registro</div></div>
            <div class="cm"><div class="cm-n">${d.servicesCount||0}</div><div class="cm-l">Serviços afetados</div></div>
            <div class="cm"><div class="cm-n">${d.appxCount||0}</div><div class="cm-l">Apps UWP removidos</div></div>
            <div class="cm"><div class="cm-n">${d.commandsCount||0}</div><div class="cm-l">Comandos executados</div></div>
        </div>
        <div class="cmp-bar"><div class="cmp-bar-label"><span>Acoes vs catalogo</span><span>${actionsPct}%</span></div><div class="cmp-bar-track"><div class="cmp-bar-fill" style="width:${actionsPct}%"></div></div></div>
        <div class="cmp-bar"><div class="cmp-bar-label"><span>Tamanho do pacote</span><span>${sizePct}%</span></div><div class="cmp-bar-track"><div class="cmp-bar-fill" style="width:${sizePct}%"></div></div></div>
        <div class="cmp-tags">${(p.tags||[]).map(t=>`<span class="tag tag-${t}">${TAGS[t]||t}</span>`).join('')}<span class="tag tag-win10">Win 10</span><span class="tag tag-win11">Win 11</span>${p.featured?'<span class="tag" style="background:rgba(245,158,11,.15);color:#fbbf24">★ Destaque</span>':''}</div>
        ${(p.risksList&&p.risksList.length)?`<details style="margin:8px 0 12px"><summary style="cursor:pointer;font-size:11.5px;color:#fbbf24;font-weight:600"><i class="fas fa-triangle-exclamation"></i> ${(p.risks||p.risksList||[]).length} risco(s) detectado(s)</summary><div style="margin-top:6px">${p.risksList.map(r=>`<div style="font-family:var(--fm);font-size:10.5px;line-height:1.55;color:#fbbf24;background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.15);border-radius:8px;padding:6px 9px;margin-bottom:4px">${esc(r)}</div>`).join('')}${((p.risks||[]).length>(p.risksList||[]).length)?`<div style="font-size:10px;color:var(--t3)">+${(p.risks||[]).length-(p.risksList||[]).length} outros…</div>`:''}</div></details>`:''}
        ${(d.downloads&&d.downloads.length)?`<details style="margin-bottom:12px"><summary style="cursor:pointer;font-size:11.5px;color:#67e8f9;font-weight:600"><i class="fas fa-cloud-arrow-down"></i> ${d.downloadsCount} download(s) durante a aplicacao</summary><div style="margin-top:6px">${d.downloads.slice(0,8).map(dl=>`<div style="font-family:var(--fm);font-size:10px;color:#67e8f9;word-break:break-all;padding:3px 0">${esc(dl.url||dl.dest||'?')}</div>`).join('')}</div></details>`:''}
        <div class="cmp-actions">
            <a href="${p.url}" target="_blank" class="pbc-dl"><i class="fas fa-download"></i> Baixar</a>
            <span class="pbc-code" style="color:#34d399" title="Verificado no licensing oficial KT WIRZADE (SHA-256)"><i class="fas fa-shield-halved"></i> Verificado</span>
        </div>
    </div>
        <div class="cmp-foot"><a href="${p.url}" target="_blank" class="cmp-dl"><i class="fas fa-download"></i> Baixar original</a><a href="comparar.html?pb=${encodeURIComponent(p.productCode)}" class="cmp-cmp">Detalhes</a></div>`;
}

window.removeCard = function(btn){
    const card = btn.closest('.cmp-card');
    const name = card.querySelector('h3').textContent.trim();
    card.remove();
    if(!document.getElementById('cards').children.length){
        document.getElementById('empty-state').style.display='';
    }
};

function render(){
    const codes = ['sel-a','sel-b','sel-c'].map(id=>document.getElementById(id).value).filter(Boolean);
    if(!codes.length){ alert('Selecione pelo menos um playbook.'); return; }
    const zone = document.getElementById('cards');
    zone.innerHTML = codes.map(c => cardHtml(byCode(c))).join('');
    document.getElementById('empty-state').style.display='none';
    renderTable(codes.map(byCode));
    zone.scrollIntoView({behavior:'smooth', block:'start'});
}

function bestMetric(ps, key, dir){ // dir 1 = maior melhor, -1 = menor melhor
    let best = null, val = dir>0?-Infinity:Infinity;
    ps.forEach(p=>{ const v=p[key]||0; if(dir>0?v>val:v<val){val=v;best=p;} });
    return best;
}

function renderTable(ps){
    const rows = [
        ['Versao', p=>'v'+esc(p.version)],
        ['Categoria', p=>TAGS[p.cat]||p.cat],
        ['Acoes totais', p=>{
            const b = bestMetric(ps,'totalActions',1);
            return `<span class="${b===p?'best':''}">${p.totalActions}</span>`;}],
        ['Arquivos de tarefa', p=>p.taskFiles],
        ['Etapas com rede', p=>{
            const b = bestMetric(ps,'networkRequired',-1);
            return `<span class="${b===p?'best':''}">${p.networkRequired}</span>`;}],
        ['Riscos', p=>{
            const b = bestMetric(ps,'risksCount',-1);
            return `<span class="${b===p?'best':''}">${p.risksCount}</span>`;}],
        ['Opcoes customizaveis', p=>{
            const b = bestMetric(ps,'optionsCount',1);
            return `<span class="${b===p?'best':''}">${p.optionsCount||0}</span>`;}],
        ['Tamanho (MB)', p=>{
            const b = bestMetric(ps,'sizeMB',-1);
            return `<span class="${b===p?'best':''}">${p.sizeMB}</span>`;}],
        ['Builds suportadas', p=>esc((p.supportedBuilds||[]).join(', ')||( 'Win 10 + 11'))],
        ['Verificado KT WIRZADE', ()=>'<span style="color:#35d56d"><i class="fas fa-circle-check"></i> Sim</span>'],
        ['Mudanças de registro', p=>{const b=Math.max(...ps.map(y=>(y.deep||{}).registryCount||0));const v=(p.deep||{}).registryCount||0;return `<span class="${v===b&&b>0?'best':''}">${v}</span>`}],
        ['Serviços afetados', p=>{const b=Math.max(...ps.map(y=>(y.deep||{}).servicesCount||0));const v=(p.deep||{}).servicesCount||0;return `<span class="${v===b&&b>0?'best':''}">${v}</span>`}],
        ['Apps UWP removidos', p=>{const b=Math.max(...ps.map(y=>(y.deep||{}).appxCount||0));const v=(p.deep||{}).appxCount||0;return `<span class="${v===b&&b>0?'best':''}">${v}</span>`}],
        ['Comandos executados', p=>(p.deep||{}).commandsCount||0],
        ['Tarefas agendadas', p=>(p.deep||{}).scheduledTaskCount||0],
    ];
    let html = '<table class="cmp-table"><thead><tr><th>Metrica</th>' + ps.map(p=>`<th>${esc(p.name)}</th>`).join('') + '</tr></thead><tbody>';
    rows.forEach(([label, fn]) => {
        html += '<tr><td style="color:var(--t3)">'+label+'</td>' + ps.map(p=>'<td>'+fn(p)+'</td>').join('') + '</tr>';
    });
    html += '</tbody></table>';
    document.getElementById('table-zone').innerHTML = html;
}

document.getElementById('btn-go').addEventListener('click', render);
document.getElementById('btn-best').addEventListener('click', () => {
    // heuristica gaming: mais acoes + menos rede + menos riscos ponderados
    const scored = CATALOG.filter(p=>p.tags.includes('gaming'))
        .map(p=>({...p, score: p.totalActions*0.001 - p.networkRequired*2 - p.risksCount*0.5}))
        .sort((a,b)=>b.score-a.score);
    if(scored.length>=2){
        document.getElementById('sel-a').value = scored[0].productCode;
        document.getElementById('sel-b').value = scored[1].productCode;
        document.getElementById('sel-c').value = '';
        render();
        const cards = document.querySelectorAll('.cmp-card');
        if(cards[0]){ const w=document.createElement('div'); w.className='cmp-winner'; w.textContent='Melhor p/ gaming'; cards[0].appendChild(w); }
    } else alert('Menos de 2 playbooks marcados como gaming.');
});
document.addEventListener('keydown', e => { if(e.key==='Enter' && (e.target.classList?.contains('cmp-select'))) render(); });

// nav scroll
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('solid',scrollY>50),{passive:true});

// auto-render se deep-link com 2+ playbooks
const preCount = ['sel-a','sel-b','sel-c'].filter(id=>document.getElementById(id).value).length;
if(params.get('pb') && preCount >= 2) render();
</script>
</BaseLayout>
