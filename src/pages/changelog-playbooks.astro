---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/changelog-playbooks.css';
---

<BaseLayout title="KT TWEAKS APBX — Changelog de Playbooks">
<Fragment slot="head-extra">
    <script type="importmap" is:inline>{ "imports": { "three": "https://unpkg.com/three@0.128.0/build/three.module.js" } }</script>
</Fragment>
<div style="max-width:1100px;margin:0 auto 30px;padding:20px 24px;background:rgba(139,92,246,.06);border:1px solid rgba(139,92,246,.2);border-radius:16px">
<h2 style="font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:1px;color:#c4b5fd;margin-bottom:8px">CATÁLOGO RENOVADO · KT TWEAKS APBX</h2>
<p style="color:var(--t2);font-size:14.5px;line-height:1.7">O catálogo agora tem <b style="color:#c4b5fd">16 playbooks atuais</b> — novos: FSOS-XR10 (sucessor do XR9, suporte nativo Win10), NOVA v0.5.0, NovaOS V6.2, SynergyOS v1.5, Z-LAG OS v5.16, Atom v0.0.7, Atlas v0.5.0-hotfix e XOS v0.574. Removidos: SOS 0.2.3, NovaOS-V4 e FSOS-XR9 (substituídos pelas novas gerações).</p>
<p style="color:var(--t2);font-size:13.5px;margin-top:10px"><i class="fas fa-shield-halved" style="color:#35d56d"></i> Todos verificados no licensing oficial do <b>KT WIRZADE</b> — compare lado a lado em <a href="comparar.html" style="color:#c4b5fd">comparar.html</a>.</p>
</div>

    <canvas id="bg-canvas"></canvas>
    <div class="scan"></div>
    <div class="noise"></div>

    <nav id="nav">
        <div class="nav-in">
            <a href="index.html" class="nav-logo"><div class="nav-logo-mark"><i class="fas fa-bolt"></i></div>KT TWEAKS <span style='font-size:.55em;color:var(--vi);letter-spacing:2px'>APBX</span></a>
            <div class="nav-links">
                <a href="index.html" class="nav-a"><i class="fas fa-home"></i> Inicio</a>
                <a href="index.html#downloads" class="nav-a">Playbooks</a>
                <a href="index.html#changelogs" class="nav-a">Changelogs</a>
                <a href="#diffs" class="nav-a">Diffs</a>
                <a href="https://github.com/KT-TWEAKS/KT-TWEAKS-APBX" target="_blank" class="nav-cta"><i class="fab fa-github"></i> GitHub</a>
            </div>
            <button class="ham" id="ham" onclick="toggleMob()"><i class="fas fa-bars"></i></button>
        </div>
        <div class="nav-progress" id="nav-progress"></div>
    </nav>
    <div class="mob-nav" id="mob-nav">
        <a href="index.html" class="mob-a"><i class="fas fa-home"></i> Inicio</a>
        <a href="index.html#downloads" class="mob-a">Playbooks</a>
        <a href="index.html#changelogs" class="mob-a">Changelogs</a>
        <a href="#diffs" class="mob-a">Diffs</a>
        <a href="https://github.com/KT-TWEAKS/KT-TWEAKS-APBX" target="_blank" class="mob-a"><i class="fab fa-github"></i> GitHub</a>
    </div>

    <section class="hero sec">
        <div class="hero-eyebrow"><span class="eyebrow-dot"></span> DOCUMENTACAO TECNICA</div>
        <h1 class="hero-title"><span class="fill">CHANGELOG</span> <span class="v">WIN10</span></h1>
        <p class="hero-sub">MODIFICACOES POR PLAYBOOK</p>
        <p class="hero-desc">Diffs detalhados das modificacoes feitas por <strong>kelvenapk</strong> em cada playbook para adicionar suporte ao <strong>Windows 10</strong>. Codigo original preservado.</p>
        <div class="hero-actions">
            <a href="index.html" class="btn-main"><i class="fas fa-arrow-left"></i> Voltar ao Site</a>
            <a href="index.html#downloads" class="btn-ghost"><i class="fas fa-download"></i> Downloads</a>
        </div>
    </section>

    <section class="sec pad"><div class="wrap">
        <div class="stats-row" data-reveal="scale">
            <div class="stat-cell"><div class="stat-n" data-count="14">14</div><div class="stat-l">Playbooks</div></div>
            <div class="stat-cell"><div class="stat-n"><span>9</span></div><div class="stat-l">Modificados</div></div>
            <div class="stat-cell"><div class="stat-n"><span>5</span></div><div class="stat-l">Ja tinham Win10</div></div>
            <div class="stat-cell"><div class="stat-n">19041<span>-19045</span></div><div class="stat-l">Builds Win10</div></div>
        </div>
    </div></section>

